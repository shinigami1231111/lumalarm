[Unit]
Description=Lumalarm wake helper (D-Bus system service)
After=dbus.service

[Service]
Type=dbus
BusName=org.lumalarm.Helper
ExecStart=/usr/lib/lumalarm/lumalarm-wake-helper
User=root
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX
Capabilities=CAP_SYS_TIME

[Install]
WantedBy=multi-user.target
