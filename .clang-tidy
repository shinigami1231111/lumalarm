# Lumalarm clang-tidy configuration.
#
# Mandatory in the local gate since 2026-10-15: scripts/ci-local.sh fails the
# whole run when clang-tidy exits non-zero on any file, and WarningsAsErrors
# '*' turns every finding into an error so the exit status really fires — a
# negative test proved plain warnings alone exit 0. .github/workflows/lint.yml
# keeps continue-on-error: true — advisory there until its runner Qt/clang
# pair is verified from a real run after the first push.
#
# Kept deliberately small and Qt-friendly: bugprone-* and performance-* find
# real defects, the modernize-* picks are the mechanical ones, and the
# readability entries encode this project's naming conventions
# (PascalCase classes, camelCase methods, m_ members, UPPER_CASE globals).

# Excluded on purpose: readability-braces-around-statements — the codebase
# intentionally writes brace-less single-statement control flow
# (`if (x)\n    y;`), so that check reported 122 deviations from project style.
Checks: >-
  -*,
  bugprone-*,
  performance-*,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-using,
  modernize-use-auto,
  readability-identifier-naming,
  readability-container-size-empty

# Every finding is an error here — that is what makes the local gate's
# exit-status check mandatory (see header). Empty = advisory.
WarningsAsErrors: '*'

# Only report diagnostics coming from our own sources and headers.
HeaderFilterRegex: '^(src|tests|helper)/.*'

FormatStyle: file

CheckOptions:
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.MethodCase
    value: camelBack
  - key: readability-identifier-naming.FunctionCase
    value: camelBack
  - key: readability-identifier-naming.PrivateMemberPrefix
    value: m_
  - key: readability-identifier-naming.ProtectedMemberPrefix
    value: m_
  - key: readability-identifier-naming.PublicMemberCase
    value: lower_case
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key: readability-identifier-naming.ConstexprVariableCase
    value: CamelCase
  # File-local constants follow the Qt/kernel kCamelCase style used across
  # the whole project (kFullScale, kCallTimeoutMs, kPkcheckTimeoutMs);
  # plain CamelCase would demand KFoo, which no file here uses.
  # (clang-tidy spells the option ...Regexp, not ...Regex.)
  - key: readability-identifier-naming.ConstexprVariableIgnoredRegexp
    value: '^k[A-Z].*'
  - key: readability-identifier-naming.GlobalConstantCase
    value: UPPER_CASE
  # File-local kCamelCase constants (kPlayerServicePrefix, kHelperService…)
  # follow the same Qt/kernel style as ConstexprVariable above — plain
  # UPPER_CASE stays the rule for every other global.
  - key: readability-identifier-naming.GlobalConstantIgnoredRegexp
    value: '^k[A-Z].*'
  # LocalConstantCase is deliberately unset: it flagged idiomatic lowercase
  # locals (entry, it, row, idx) and produced 71 findings on its own.
  - key: readability-identifier-naming.LocalVariableCase
    value: camelBack
