# Lumalarm clang-tidy configuration.
#
# Advisory in this phase: WarningsAsErrors is empty, and both
# scripts/ci-local.sh and .github/workflows/lint.yml treat findings as
# non-fatal (lint.yml uses continue-on-error: true). Turn findings into
# errors by adding the check names below to WarningsAsErrors.
#
# Kept deliberately small and Qt-friendly: bugprone-* and performance-* find
# real defects, the modernize-* picks are the mechanical ones, and the
# readability entries encode this project's naming conventions
# (PascalCase classes, camelCase methods, m_ members, UPPER_CASE globals).

# Excluded on purpose: readability-braces-around-statements — the codebase
# intentionally writes brace-less single-statement control flow
# (`if (x)\n    y;`), so that check reported 122 deviations from project style.
Checks: >-
  -*,
  bugprone-*,
  performance-*,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-using,
  modernize-use-auto,
  readability-identifier-naming,
  readability-container-size-empty

WarningsAsErrors: ''

# Only report diagnostics coming from our own sources and headers.
HeaderFilterRegex: '^(src|tests|helper)/.*'

FormatStyle: file

CheckOptions:
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.MethodCase
    value: camelBack
  - key: readability-identifier-naming.FunctionCase
    value: camelBack
  - key: readability-identifier-naming.PrivateMemberPrefix
    value: m_
  - key: readability-identifier-naming.ProtectedMemberPrefix
    value: m_
  - key: readability-identifier-naming.PublicMemberCase
    value: lower_case
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key: readability-identifier-naming.ConstexprVariableCase
    value: CamelCase
  - key: readability-identifier-naming.GlobalConstantCase
    value: UPPER_CASE
  # LocalConstantCase is deliberately unset: it flagged idiomatic lowercase
  # locals (entry, it, row, idx) and produced 71 findings on its own.
  - key: readability-identifier-naming.LocalVariableCase
    value: camelBack
